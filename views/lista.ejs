<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=c.titulo%></title><link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css"></head><body>
<nav class="navbar navbar-dark bg-dark"><div class="container"><a class="navbar-brand" href="/">Sistema Node.js</a><a class="btn btn-outline-light btn-sm" href="/">Início</a></div></nav>
<main class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><h1><%=c.titulo%></h1><a class="btn btn-success" href="/<%=e%>/novo">+ Novo</a></div>
<% if(msg){ %><div class="alert alert-success"><%=msg%></div><% } %><div class="card p-3"><% if(!dados.length){ %><p class="text-center my-5">Nenhum registro cadastrado.</p><% }else{ %><div class="table-responsive"><table class="table table-hover align-middle"><thead class="table-dark"><tr><th>#</th><% c.campos.forEach(x=>{ %><th><%=x[1]%></th><% }) %><th>Ações</th></tr></thead><tbody><% dados.forEach(item=>{ %><tr><td><%=item.id%></td><% c.campos.forEach(x=>{ %><td><%=x[0]==='preco'?'R$ '+Number(item[x[0]]).toFixed(2).replace('.',','):item[x[0]]%></td><% }) %><td><a class="btn btn-warning btn-sm" href="/<%=e%>/editar/<%=item.id%>">Editar</a> <form class="d-inline" method="post" action="/<%=e%>/excluir/<%=item.id%>" onsubmit="return confirm('Excluir este registro?')"><button class="btn btn-danger btn-sm">Excluir</button></form></td></tr><% }) %></tbody></table></div><% } %></div></main></body></html>